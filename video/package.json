{
  "name": "novacademy-video",
  "private": true,
  "type": "module",
  "description": "Remotion pipeline that renders module preface videos (TTS -> timed slides -> MP4 + poster + captions) and uploads them to the course-video bucket.",
  "scripts": {
    "studio": "remotion studio",
    "tts": "node scripts/tts.mjs",
    "render": "node scripts/render.mjs",
    "smoke": "node scripts/render.mjs --smoke",
    "upload": "node scripts/upload.mjs",
    "make": "node scripts/render.mjs && node scripts/upload.mjs"
  },
  "dependencies": {
    "@remotion/bundler": "^4.0.0",
    "@remotion/cli": "^4.0.0",
    "@remotion/renderer": "^4.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "^4.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "typescript": "^5.7.2"
  }
}
