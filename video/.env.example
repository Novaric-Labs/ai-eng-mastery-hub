# TTS (required to render real audio). Copy to .env and fill in.
ELEVENLABS_API_KEY=
# Optional: override the narrator voice. Defaults to a calm neutral voice.
# Browse voices at https://elevenlabs.io/app/voice-library (copy the Voice ID).
ELEVENLABS_VOICE_ID=
# Optional: model. eleven_turbo_v2_5 (cheap, fast) | eleven_multilingual_v2 (higher quality)
ELEVENLABS_MODEL_ID=eleven_turbo_v2_5

# Upload reuses the Supabase service role. These already live in
# app-next/.env.local — run the upload script with:
#   node --env-file=../app-next/.env.local --env-file=.env scripts/upload.mjs
# NEXT_PUBLIC_SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
