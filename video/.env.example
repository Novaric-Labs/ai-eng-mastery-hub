# TTS (required to render real audio). Copy to .env and fill in.
ELEVENLABS_API_KEY=
# Optional: override the narrator voice. Defaults to a calm neutral voice.
# Browse voices at https://elevenlabs.io/app/voice-library (copy the Voice ID).
ELEVENLABS_VOICE_ID=
# Optional: model. Course default is eleven_multilingual_v2 (premium, natural).
# eleven_turbo_v2_5 = cheaper/faster; eleven_v3 = expressive but adds breath/mic
# realism (avoid — we want clean narration).
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
# Optional: language. Only honored by the v2_5 (turbo/flash) models; ignored by
# multilingual_v2 (it infers). Defaults to en.
ELEVENLABS_LANGUAGE=en
# Optional: voice settings. Lower stability = more natural prosody (less flat),
# too low risks drift. Course defaults: stability 0.4, similarity 0.8, style 0.
ELEVENLABS_STABILITY=0.4
ELEVENLABS_SIMILARITY=0.8
ELEVENLABS_STYLE=0

# Upload reuses the Supabase service role. These already live in
# app-next/.env.local — run the upload script with:
#   node --env-file=../app-next/.env.local --env-file=.env scripts/upload.mjs
# NEXT_PUBLIC_SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
