# Copy to .env and fill in. .env is gitignored - never commit a real key.
#
#   cp .env.example .env          (macOS/Linux)
#   Copy-Item .env.example .env   (PowerShell)
#
# The skeleton runs with this file untouched: retrieval works offline and generation
# falls back to an extractive stub. You need keys only when you wire up call_llm() and
# the promptfoo judge.

# =====================================================================================
# Models
# =====================================================================================
# EVERY MODEL ID BELOW IS AN EXAMPLE, NOT A RECOMMENDATION. Model ids and prices change
# constantly - the ones here were plausible in August 2026 and may already be wrong.
# Look up the current model list and price for your provider before you spend anything,
# then record what you actually used in your submission README.

# The model that writes the final answer. Quality matters most here.
# EXAMPLE: ANSWER_MODEL=claude-opus-5
ANSWER_MODEL=

# The model that grades retrieval, rewrites queries, and checks groundedness. These run
# several times per question, so this is where a fast/cheap tier pays off. Routing the
# loop steps to a cheaper model than the answer step is the single largest cost lever in
# this lab - see the README cost section.
# EXAMPLE: GRADER_MODEL=<your-provider-fast-tier-model-id>
GRADER_MODEL=

# Embeddings. Leave RAG_EMBEDDER=hashing to stay offline and free.
#   hashing  offline bag-of-words fallback, no dependencies, weak (the shipped default)
#   local    sentence-transformers on CPU, free after download
#   remote   a hosted embedding API, costs money per ingest
RAG_EMBEDDER=hashing
# EXAMPLE: EMBED_MODEL=bge-small-en-v1.5
EMBED_MODEL=

# =====================================================================================
# Credentials - fill in only the provider you actually use
# =====================================================================================
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Generic escape hatch for an OpenAI-compatible gateway, a local vLLM/Ollama server, or
# a proxy. If you route everything through one gateway, set these and leave the rest
# blank - it keeps provider choice out of the code.
LLM_BASE_URL=
LLM_API_KEY=

# =====================================================================================
# Retrieval and loop budgets (defaults are in starter/pipeline.py)
# =====================================================================================
# Documents scored by recall@k. Changing this changes what the gate means.
RAG_TOP_K=5
# How wide the net is before reranking cuts it down to RAG_TOP_K.
RAG_CANDIDATE_K=25
# Hard ceiling on grade -> rewrite -> re-search cycles. This is your runaway-loop guard.
RAG_MAX_ITERATIONS=3
# Hard ceiling on model calls per question. Set it low while developing.
RAG_MAX_LLM_CALLS=12
# Wall-clock budget per question, in seconds.
RAG_DEADLINE_SECONDS=60
# Dimension for the offline hashing embedder only.
RAG_EMBED_DIM=512

# =====================================================================================
# Optional: pgvector instead of the local SQLite store
# =====================================================================================
# EXAMPLE: DATABASE_URL=postgresql://postgres:postgres@localhost:5432/meridian_rag
DATABASE_URL=
